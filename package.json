{
  "name": "stockbit-mcp",
  "version": "0.1.0",
  "description": "MCP server for Stockbit: market data, broker and foreign flow, fundamentals, portfolio and confirmed order execution",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stockbit",
    "idx",
    "saham",
    "trading",
    "claude"
  ],
  "license": "MIT",
  "author": {
    "name": "Mochamad Rizky",
    "url": "https://github.com/Mochamad-Rizky"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "stockbit-mcp": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --coverage",
    "docs:tools": "tsx scripts/docs-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
